# GEMINI_API_KEY: Required for Gemini AI API calls (/api/chat and /api/translate).
# Configure on the backend server only; NEVER expose in frontend VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_BACKEND_API_URL: Public URL of your deployed backend service (Render / Cloud Run)
# Required when deploying the static frontend to GitHub Pages (https://toolcrest.site).
# Example: https://toolcrest-ai-backend.onrender.com
VITE_BACKEND_API_URL=""

# ALLOWED_ORIGINS: Optional comma-separated extra browser origins allowed for CORS.
ALLOWED_ORIGINS="https://toolcrest.site,https://www.toolcrest.site"
