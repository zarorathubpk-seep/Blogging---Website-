rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mralexander461@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['slug', 'title', 'content', 'author', 'isPublished']) &&
             data.keys().hasOnly(['id', 'slug', 'title', 'subtitle', 'content', 'category', 'readingTime', 'author', 'publishedAt', 'updatedAt', 'isPublished', 'order', 'imageUrl']) &&
             data.slug is string && data.slug.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500)) &&
             data.content is string && data.content.size() <= 50000 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             (!('readingTime' in data) || (data.readingTime is string && data.readingTime.size() <= 30)) &&
             data.author is string && data.author.size() <= 60 &&
             data.isPublished is bool &&
             (!('order' in data) || data.order is number) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'createdAt', 'status']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'category', 'message', 'createdAt', 'status', 'source', 'botTrap']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 200 &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 4000 &&
             data.createdAt is string &&
             data.status in ['unread', 'read', 'archived'] &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
             (!('botTrap' in data) || (data.botTrap is string && data.botTrap.size() == 0));
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow update: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
